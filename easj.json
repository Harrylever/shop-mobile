{
  "cli": {
    "version": ">= 21.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "defaults": {
      "bun": "1.4.0",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "defaults",
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "autoIncrement": true,
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "defaults",
      "distribution": "internal",
      "android": {
        "autoIncrement": true,
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "defaults",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "defaults",
      "distribution": "store",
      "android": {
        "autoIncrement": true,
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
